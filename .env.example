# Dummy example values: replace before deploying.

# Base URL of the backend API (include the /api/v1 path, no trailing slash).
# Local:  http://localhost:5000/api/v1
# Prod:   https://api.thezenithlearning.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public media CDN (CloudFront on the media subdomain). No trailing slash.
# Files are served from here, never through the API.
NEXT_PUBLIC_CDN_BASE_URL=https://media.thezenithlearning.com
